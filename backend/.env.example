# Copy this file to .env and fill in values locally.
# Never commit .env files.

APP_NAME=EmailThreatDetectionSystem
APP_ENV=development

# Geolocation provider
GEOLOCATION_PROVIDER_URL=https://ipapi.co/{ip}/json/
GEOLOCATION_TIMEOUT=5

# Future API keys
# GEOLOCATION_API_KEY=
# THREAT_INTEL_API_KEY=

# Optional Member 5 external threat intelligence (never required)
# VIRUSTOTAL_API_KEY=
# ABUSEIPDB_API_KEY=
# THREAT_INTEL_TIMEOUT=3
